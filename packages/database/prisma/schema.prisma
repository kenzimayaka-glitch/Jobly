model User {
  id              String       @id @default(cuid())
  authUserId       String?      @unique
  email           String?      @unique
  phone           String?      @unique
  displayName     String?
  // Ajouts 15/09/2026 : requis par /api/auth/complete-signup et
  // /api/auth/username/check, absents du schéma jusqu'ici (cause de l'erreur
  // "column User.username does not exist" à la création de compte).
  username          String?   @unique
  firstName         String?
  lastName          String?
  country           String?
  privacyAcceptedAt DateTime?
  role            UserRole     @default(TALENT)
  profilePhotoUrl String?
  pitchVideoUrl String?
  pitchVideoStoragePath String?
  pitchVideoDurationMs Int?
  pitchVideoUpdatedAt DateTime?
  showcaseConfig Json @default("{}")
  actionImages Json @default("[]")
  portfolioBusiness Json @default("{}")
  executiveSummary String?
  advertisingVideoUrl String?
  advertisingVideoStoragePath String?
  advertisingVideoDurationMs Int?
  advertisingVideoUpdatedAt DateTime?
  cvPhotoUrl      String?
  cvOriginalStoragePath String?
  cvOriginalFileName String?
  cvOriginalPageCount Int?
  cvOriginalUploadedAt DateTime?
  englishLevel    String?
  licences        String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profile         Profile?
  experiences     Experience[]
  skills          Skill[]
  education       Education[]
  applications    Application[]
  subscriptions   Subscription[]
  qrShares        QRShare[]
  partner         Partner?
  auditLogs       AuditLog[]
  aiUsages        AiUsage[]
  aiWelcomeCredits Int          @default(0)
  aiWelcomeGrantedAt DateTime?
  aiWelcomeSeenAt DateTime?
  careerJourney CareerJourney?
  careerGoals CareerGoal[]
  careerMissions CareerMission[]
  careerEvidence CareerEvidence[]
  careerPortfolio CareerPortfolioItem[]
  careerRecommendations CareerRecommendation[]
  careerAssessments CareerCompetencyAssessment[]
  careerAttempts CareerCompetencyAttempt[]
  careerReviews CareerReview[]
