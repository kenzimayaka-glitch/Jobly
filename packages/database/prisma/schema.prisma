enum CareerEvidenceProvenance { DECLARED DOCUMENTED AI_EVALUATED CONVERGENT }
enum CareerRecommendationType { APPLY DEFER_APPLICATION UPDATE_CV LEARN PRACTICE PROJECT PORTFOLIO INTERVIEW_PREP EXPLORE_PATH REASSESS READY_TO_APPLY }
enum CareerReviewFrequency { OFF WEEKLY MONTHLY }
enum CareerAssessmentFormat { MCQ CASE ROLEPLAY PRACTICAL ORAL PORTFOLIO }

