}

enum PlanCode {
  FREE
  START
  PREMIUM
  PRO
  PREMIUM_MONTHLY
  PREMIUM_ANNUAL
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
