generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RecruiterJobStatus {
  draft
  published
  closed
}

enum UserRole {
  TALENT
  RECRUITER
  PARTNER
  ADMIN
  SUPPORT
  FINANCE
  MODERATOR
  ANALYST
}

enum Provenance {
  DECLARED
  DOCUMENT
  VERIFIED
  INFERRED
}

enum ApplicationStatus {
  DISCOVERED
  PREPARED
  USER_REVIEW
  SUBMITTING
  SUBMITTED
  ACKNOWLEDGED
  INTERVIEW
  OFFER
  REJECTED
  WITHDRAWN
}

enum SubscriptionStatus {
  TRIAL
  PENDING
  ACTIVE
  EXPIRED
  CANCELED
}

enum PlanCode {
  FREE
  START
  PREMIUM
  PRO
  PREMIUM_MONTHLY
  PREMIUM_ANNUAL
}

enum BillingInterval {
  MONTHLY
  ANNUAL
}

model SubscriptionPlan {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  monthlyPrice    Int
  annualPrice     Int
  aiCredits       Int
  storageMb       Int
  features        Json
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  userId      String
  endpoint    String
  key         String
  payloadHash String
  statusCode  Int
  response    Json
  createdAt   DateTime @default(now())
  @@unique([userId, endpoint, key])
  @@index([createdAt])
}

model PaymentWebhookEvent {
  id               String   @id @default(cuid())
  provider         String
  externalEventId  String
  eventType        String
  payloadHash      String
  payload          Json
  receivedAt       DateTime @default(now())
  processedAt      DateTime?
  status            String   @default("RECEIVED")
  error            String?
  @@unique([provider, externalEventId])
  @@index([provider, receivedAt])
}

enum CommissionStatus {
  GENERATED
  PENDING
  VALIDATED
  PAYABLE
  PAYMENT_EXECUTED
  PAID
  REJECTED
}

enum QRShareType {
  PROFILE
  CV
  PORTFOLIO
  REPORT
  JOBLY_ID
}

model User {
  id              String       @id @default(cuid())
  authUserId       String?      @unique
  email           String?      @unique
  phone           String?      @unique
  displayName     String?
  // Ajouts 15/09/2026 : requis par /api/auth/complete-signup et
  // /api/auth/username/check, absents du schéma jusqu'ici (cause de l'erreur
  // "column User.username does not exist" à la création de compte).
  username          String?   @unique
  firstName         String?
  lastName          String?
  country           String?
  privacyAcceptedAt DateTime?
  role            UserRole     @default(TALENT)
  profilePhotoUrl String?
  pitchVideoUrl String?
  pitchVideoStoragePath String?
  pitchVideoDurationMs Int?
  pitchVideoUpdatedAt DateTime?
  showcaseConfig Json @default("{}")
  actionImages Json @default("[]")
  portfolioBusiness Json @default("{}")
  executiveSummary String?
  advertisingVideoUrl String?
  advertisingVideoStoragePath String?
  advertisingVideoDurationMs Int?
  advertisingVideoUpdatedAt DateTime?
  cvPhotoUrl      String?
  cvOriginalStoragePath String?
  cvOriginalFileName String?
  cvOriginalPageCount Int?
  cvOriginalUploadedAt DateTime?
  englishLevel    String?
  licences        String[]     @default([])
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  profile         Profile?
  experiences     Experience[]
  skills          Skill[]
  education       Education[]
  applications    Application[]
  subscriptions   Subscription[]
  qrShares        QRShare[]
  partner         Partner?
  auditLogs       AuditLog[]
  aiUsages        AiUsage[]
  aiWelcomeCredits Int          @default(0)
  aiWelcomeGrantedAt DateTime?
  aiWelcomeSeenAt DateTime?
  careerJourney CareerJourney?
  careerGoals CareerGoal[]
  careerMissions CareerMission[]
  careerEvidence CareerEvidence[]
  careerPortfolio CareerPortfolioItem[]
  careerRecommendations CareerRecommendation[]
  careerAssessments CareerCompetencyAssessment[]
  careerAttempts CareerCompetencyAttempt[]
  careerReviews CareerReview[]
  watchSubscriptions JiaWatchSubscription[]
}

model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  institutionId  String?  @db.Uuid
  // Ajouts 15/09/2026 : requis par /api/auth/complete-signup, absents du
  // schéma jusqu'ici (même cause que sur User : erreur au moment d'écrire le
  // profil à la fin de l'inscription).
  firstName      String?
  lastName       String?
  phone          String?
  country        String?
  headline       String?
  summary        String?
  location       String?
  targetRoles    String[] @default([])
  preferredSectors String[] @default([])
  // Ajouts spec 6.1 / 12.1 (onboarding Career Brain, étape "Objectifs")
  targetCities        String[] @default([]) // villes souhaitées pour un emploi (distinct de `location`)
  contractPreferences String[] @default([]) // ex: ["CDI","CDD"], plusieurs choix possibles
  remotePreference    String   @default("INDIFFERENT") // "YES" | "NO" | "INDIFFERENT"
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
}

model Experience {
  id          String     @id @default(cuid())
  userId      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  provenance  Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id         String     @id @default(cuid())
  userId     String
  name       String
  level      String?
  provenance Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id          String     @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  provenance  Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  logoUrl     String?
  verified    Boolean  @default(false)
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Job {
  id             String   @id @default(cuid())
  companyId      String?
  title          String
  description    String
  language       String   @default("fr")
  location       String?
  contractType   String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?  @default("XAF")
  source         String?
  sourceUrl      String?
  deadline       DateTime?
  lastSeenAt     DateTime?
  isActive       Boolean  @default(true)
  // Ajouts spec 12.1 (calcul du % de correspondance)
  remoteMode          String  @default("NO") // "YES" | "NO" | "PARTIAL"
  minExperienceYears  Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications   Application[]
  matches        Match[]

  @@unique([source, sourceUrl], name: "source_sourceUrl")
}

model RecruiterJob {
  id             String             @id @default(cuid())
  recruiterUserId String
  title          String
  companyName    String             @default("Mon entreprise")
  description    String
  location       String?
  countryCode    String?
  distributionScope String @default("LOCAL")
  targetCountryCodes String[] @default([])
  mode           String             @default("Hybride") // libellé affiché tel quel (ex: "Présentiel", "Hybride")
  contract       String             @default("CDI")
  salary         String?
  sector         String?
  tags           String[]           @default([])
  status         RecruiterJobStatus @default(draft)
  // Ajouts 12/09/2026 — unification avec Job pour le Matching V1 (spec 12.1)
  remoteMode         String @default("NO") // "YES" | "NO" | "PARTIAL", dérivé de `mode` mais normalisé pour le calcul de score
  minExperienceYears Int    @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   Application[]

  @@index([recruiterUserId])
}

model Match {
  id          String   @id @default(cuid())
  jobId       String
  userId      String
  score       Int
  category    String
  reasons     Json
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  jobId          String?
  recruiterJobId String?
  status         ApplicationStatus @default(DISCOVERED)
  language       String
  cvUrl          String?
  cvPhotoUrl     String?
  letterText     String?
  atsScore       Int?
  submittedAt    DateTime?
  // Ajouts spec 12.2 (écran Candidatures V1)
  proofUrl       String?           // capture/photo de preuve de candidature jointe par le candidat
  viewedAt       DateTime?         // horodatage de la première ouverture par un recruteur (statut "Vu")
  interviewAt    DateTime?         // date d'entretien renseignée manuellement
  statusSource   String   @default("CANDIDATE") // "CANDIDATE" | "RECRUITER" — qui a fixé le statut final en cas de conflit
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterJob   RecruiterJob?     @relation(fields: [recruiterJobId], references: [id], onDelete: Cascade)

  // Exactement une des deux sources (voir contrainte CHECK dans la migration SQL) :
  // une candidature porte soit sur une offre Discovery (jobId), soit sur une offre
  // publiée par un recruteur JOBLY (recruiterJobId) — jamais les deux, jamais aucune.
  @@unique([userId, jobId])
  @@unique([userId, recruiterJobId])
}

model Subscription {
  id                  String             @id @default(cuid())
  userId              String
  plan                PlanCode
  status              SubscriptionStatus
  billingInterval     BillingInterval?
  priceAmount         Int?
  priceCurrency       String             @default("XAF")
  provider            String?
  currentPeriodStart  DateTime?
  currentPeriodEnd    DateTime?
  trialStartedAt      DateTime?
  trialEndsAt    DateTime?
  canceledAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Payment {
  id              String   @id @default(cuid())
  feature         String?
  userId          String
  subscriptionId  String?
  provider        String
  externalId      String?  @unique
  amount          Int
  currency        String   @default("XAF")
  status          String
  idempotencyKey  String?
  paidAt          DateTime?
  refundedAt      DateTime?
  failureReason   String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@index([userId, createdAt])
  @@index([subscriptionId])
}

model Partner {
  id             String   @id @default(cuid())
  userId         String   @unique
  referralCode   String   @unique
  payoutProvider String?
  payoutPhone    String?
  kycStatus      String   @default("PENDING")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  commissions    Commission[]
}

model Commission {
  id          String           @id @default(cuid())
  partnerId   String
  event       String
  amount      Int
  currency    String           @default("XAF")
  status      CommissionStatus @default(GENERATED)
  createdAt   DateTime         @default(now())
  paidAt      DateTime?
  partner     Partner          @relation(fields: [partnerId], references: [id], onDelete: Cascade)
}

model QRShare {
  id          String       @id @default(cuid())
  userId      String
  tokenHash   String       @unique
  type        QRShareType
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime     @default(now())
  user         User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model CourseRecommendation {
  id          String   @id @default(cuid())
  skill       String
  title       String
  provider    String
  url         String
  isFree      Boolean  @default(true)
  language    String   @default("fr")
  createdAt   DateTime @default(now())
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
}


model DiscoveryQueueItem {
  id          String   @id @default(cuid())
  sourceId    String
  status      DiscoveryQueueStatus @default(PENDING)
  scheduledAt DateTime
  startedAt   DateTime?
  finishedAt  DateTime?
  attempts    Int      @default(0)
  lastError   String?
  lockedBy    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([status, scheduledAt])
  @@unique([sourceId, scheduledAt])
}

enum DiscoveryQueueStatus {
  PENDING
  RUNNING
  SUCCEEDED
  FAILED
  SKIPPED
}

model DiscoveryRun {
  id          String   @id @default(cuid())
  sourceId    String
  queueItemId String?
  status      String
  fetched     Int      @default(0)
  created     Int      @default(0)
  updated     Int      @default(0)
  skipped     Int      @default(0)
  expired     Int      @default(0)
  durationMs  Int?
  error       String?
  createdAt   DateTime @default(now())
  source      JobSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

model JobSource {
  id              String   @id @default(cuid())
  name            String   @unique
  baseUrl         String
  searchUrl       String?
  country         String   @default("CM")
  language        String   @default("fr")
  active          Boolean  @default(true)
  discoveryStatus String   @default("READY")
  ingestionMode   String   @default("EXTERNAL_LINK")
  adapterKey      String?
  feedUrl         String?
  maxItems        Int      @default(50)
  staleAfterHours Int      @default(168)
  requestTimeoutMs Int     @default(15000)
  lastQueuedAt    DateTime?
  lastRunAt       DateTime?
  lastSuccessAt   DateTime?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  discoveryQueue  DiscoveryQueueItem[]
  discoveryRuns   DiscoveryRun[]
}

enerator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

