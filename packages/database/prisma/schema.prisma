model Profile {
  id             String   @id @default(cuid())
  userId         String   @unique
  institutionId  String?  @db.Uuid
  // Ajouts 15/09/2026 : requis par /api/auth/complete-signup, absents du
  // schéma jusqu'ici (même cause que sur User : erreur au moment d'écrire le
  // profil à la fin de l'inscription).
  firstName      String?
  lastName       String?
  phone          String?
  country        String?
  headline       String?
  summary        String?
  location       String?
  targetRoles    String[] @default([])
  preferredSectors String[] @default([])
  // Ajouts spec 6.1 / 12.1 (onboarding Career Brain, étape "Objectifs")
  targetCities        String[] @default([]) // villes souhaitées pour un emploi (distinct de `location`)
  contractPreferences String[] @default([]) // ex: ["CDI","CDD"], plusieurs choix possibles
  remotePreference    String   @default("INDIFFERENT") // "YES" | "NO" | "INDIFFERENT"
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  institution    Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
}

model Experience {
  id          String     @id @default(cuid())
  userId      String
  company     String
  title       String
  startDate   DateTime
  endDate     DateTime?
  description String?
  provenance  Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Skill {
  id         String     @id @default(cuid())
  userId     String
  name       String
  level      String?
  provenance Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Education {
  id          String     @id @default(cuid())
  userId      String
  institution String
  degree      String?
  field       String?
  startDate   DateTime?
  endDate     DateTime?
  provenance  Provenance @default(DECLARED)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Company {
  id          String   @id @default(cuid())
  name        String
  description String?
  website     String?
  logoUrl     String?
  verified    Boolean  @default(false)
  jobs        Job[]
  createdAt   DateTime @default(now())
}

model Job {
  id             String   @id @default(cuid())
  companyId      String?
  title          String
  description    String
  language       String   @default("fr")
  location       String?
  contractType   String?
  salaryMin      Int?
  salaryMax      Int?
  salaryCurrency String?  @default("XAF")
  source         String?
  sourceUrl      String?
  deadline       DateTime?
  lastSeenAt     DateTime?
  isActive       Boolean  @default(true)
  // Ajouts spec 12.1 (calcul du % de correspondance)
  remoteMode          String  @default("NO") // "YES" | "NO" | "PARTIAL"
  minExperienceYears  Int     @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  applications   Application[]
  matches        Match[]

  @@unique([source, sourceUrl], name: "source_sourceUrl")
}

model RecruiterJob {
  id             String             @id @default(cuid())
  recruiterUserId String
  title          String
  companyName    String             @default("Mon entreprise")
  description    String
  location       String?
  countryCode    String?
  distributionScope String @default("LOCAL")
  targetCountryCodes String[] @default([])
  mode           String             @default("Hybride") // libellé affiché tel quel (ex: "Présentiel", "Hybride")
  contract       String             @default("CDI")
  salary         String?
  sector         String?
  tags           String[]           @default([])
  status         RecruiterJobStatus @default(draft)
  // Ajouts 12/09/2026 — unification avec Job pour le Matching V1 (spec 12.1)
  remoteMode         String @default("NO") // "YES" | "NO" | "PARTIAL", dérivé de `mode` mais normalisé pour le calcul de score
  minExperienceYears Int    @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  applications   Application[]

  @@index([recruiterUserId])
}

model Match {
  id          String   @id @default(cuid())
  jobId       String
  userId      String
  score       Int
  category    String
  reasons     Json
  createdAt   DateTime @default(now())
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model Application {
  id             String            @id @default(cuid())
  userId         String
  jobId          String?
  recruiterJobId String?
  status         ApplicationStatus @default(DISCOVERED)
  language       String
  cvUrl          String?
  cvPhotoUrl     String?
  letterText     String?
  atsScore       Int?
  submittedAt    DateTime?
  // Ajouts spec 12.2 (écran Candidatures V1)
  proofUrl       String?           // capture/photo de preuve de candidature jointe par le candidat
  viewedAt       DateTime?         // horodatage de la première ouverture par un recruteur (statut "Vu")
  interviewAt    DateTime?         // date d'entretien renseignée manuellement
  statusSource   String   @default("CANDIDATE") // "CANDIDATE" | "RECRUITER" — qui a fixé le statut final en cas de conflit
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  job            Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  recruiterJob   RecruiterJob?     @relation(fields: [recruiterJobId], references: [id], onDelete: Cascade)

  // Exactement une des deux sources (voir contrainte CHECK dans la migration SQL) :
  // une candidature porte soit sur une offre Discovery (jobId), soit sur une offre
  // publiée par un recruteur JOBLY (recruiterJobId) — jamais les deux, jamais aucune.
  @@unique([userId, jobId])
  @@unique([userId, recruiterJobId])
}

