model MobilityRepaymentPlan {
  id String @id @default(uuid()) @db.Uuid
  allocationId String @db.Uuid
  guarantorRecruiterUserId String @db.Uuid
  totalAmount Decimal @db.Decimal(18,2)
  currency String @default("XAF")
  installmentCount Int @default(3)
  installmentAmount Decimal @db.Decimal(18,2)
  deductionMethod String @default("PAYROLL_API")
  startAt DateTime?
  endAt DateTime?
  status String @default("PENDING")
  terminationStillDue Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InstitutionCommunication {
  id String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  programId String? @db.Uuid
  sourceEcosystem String
  targetEcosystem String
  eventType String
  payload Json @default("{}")
  status String @default("QUEUED")
  createdAt DateTime @default(now())
  deliveredAt DateTime?
  @@index([institutionId, createdAt])
}

model MobilityDocument {
  id String @id @default(uuid()) @db.Uuid
  mobilityRequestId String @db.Uuid
  documentType String
  side String?
  fileName String
  storagePath String
  mimeType String?
  fileSize BigInt?
  validUntil DateTime?
  status String @default("PENDING")
  uploadedByUserId String
  verifiedByUserId String?
  verifiedAt DateTime?
  rejectionReason String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([mobilityRequestId, documentType, status])
}

model MobilityProcessEvent {
  id String @id @default(uuid()) @db.Uuid
  mobilityRequestId String @db.Uuid
  actorUserId String?
  actorRole String?
  eventType String
  fromStatus String?
  toStatus String?
  title String
  description String?
  metadata Json @default("{}")
  visibleToTalent Boolean @default(true)
  visibleToRecruiter Boolean @default(false)
  visibleToInstitution Boolean @default(true)
  createdAt DateTime @default(now())
  @@index([mobilityRequestId, createdAt])
}
