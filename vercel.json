{
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/jobs/ingest/sources",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/jobs/reindex?limit=40&offset=0",
      "schedule": "30 5 * * *"
    }
  ]
}
