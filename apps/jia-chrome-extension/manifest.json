{
  "manifest_version": 3,
  "name": "Jobly — J'IA Assistant de candidature",
  "version": "0.1.0",
  "description": "Garde le contexte d'une offre Jobly et aide à comprendre les formulaires externes.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "tabs", "sidePanel", "scripting"],
  "host_permissions": ["https://jobly-c0651.vercel.app/*", "https://jobly-c0651-portfolio-5555.vercel.app/*"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "Ouvrir J'IA — candidature" },
  "side_panel": { "default_path": "sidepanel.html" },
  "content_scripts": [{ "matches": ["https://jobly-c0651.vercel.app/*", "https://jobly-c0651-portfolio-5555.vercel.app/*"], "js": ["jobly-bridge.js"], "run_at": "document_start" }]
}