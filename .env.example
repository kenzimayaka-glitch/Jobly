# JOBLY — Variables d'environnement requises
# Généré automatiquement le 16/09/2026 à partir d'une recherche exhaustive de
# `process.env.*` dans app/, components/ et lib/. Ce fichier n'existait pas
# dans le livrable audité : sans lui, un déploiement à froid (Vercel, local)
# ne peut pas deviner quelles clés sont attendues.

# --- Supabase (auth, DB, storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- URLs publiques de l'app (liens de partage, QR, redirections email) ---
NEXT_PUBLIC_JOBLY_PUBLIC_URL=
JOBLY_PUBLIC_URL=
JOBLY_API_BASE_URL=

# --- Paiement iClan (abonnements, Mobile Money) ---
ICLAN_API_URL=
ICLAN_USERNAME=
ICLAN_PASSWORD=
ICLAN_WEBHOOK_SECRET=
ICLAN_DEFAULT_PAYMENT_METHOD=

# --- IA (J'IA / Career Brain) ---
GEMINI_API_KEY=
GEMINI_MODEL=

# --- Sources emploi structurées (optionnelles) ---
# MinaJobs RSS est utilisable sans clé. Les autres adaptateurs restent inactifs tant que la clé n'est pas fournie.
MINAJOBS_RSS_URL=https://cm2024.minajobs.net/rss
TECHMAP_RAPIDAPI_KEY=
TECHMAP_RAPIDAPI_HOST=daily-international-job-postings.p.rapidapi.com
TECHMAP_API_URL=
JOBSPIPE_API_KEY=
JOBSPIPE_API_URL=https://api.jobspipe.dev/v1/jobs/search
JOOBLE_API_KEY=
JOOBLE_API_URL=
JOOBLE_KEYWORDS=emploi

# --- Rendu navigateur des offres externes (optionnel, recommandé) ---
# Endpoint compatible : POST JSON { url, waitUntil, waitMs } -> HTML ou { html, finalUrl }.
# Quand configuré, Jobly privilégie le DOM rendu JS ; sinon le collecteur HTTP actuel reste le fallback.
JOB_RENDERER_URL=
JOB_RENDERER_TOKEN=
JOB_RENDERER_WAIT_MS=1200
JOB_RENDERER_TIMEOUT_MS=20000

# --- Sources externes optionnelles ---
BRANDFETCH_CLIENT_ID=
MICROSOFT_LEARN_API_TOKEN=

# --- Sécurité webhooks ---
PAYMENT_WEBHOOK_MAX_SKEW_SECONDS=300

# --- Next.js ---
NODE_ENV=development

# Optional: public animated Jobly GIF used in candidate emails
JOBLY_EMAIL_PROMO_GIF_URL=

# --- Logo.dev company logos ---
# Server-side secret used for company/domain resolution.
LOGO_DEV_SECRET_KEY=
# Enable binary self-hosting only when the active Logo.dev plan/terms permit it (Pro+ currently lists self-host logos).
LOGO_DEV_SELF_HOST_ENABLED=false
